{
  "manifest_version": 3,
  "name": "Motwi",
  "version": "0.1.0",
  "description": "Motwi's decisions, undo buttons and ban requests inside your Twitch chat.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Motwi",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "background": { "service_worker": "worker.js" },
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "ws://127.0.0.1/*",
    "https://*.trycloudflare.com/*",
    "wss://*.trycloudflare.com/*",
    "https://id.twitch.tv/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.twitch.tv/*", "https://dashboard.twitch.tv/*"],
      "js": ["page-world.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.twitch.tv/*", "https://dashboard.twitch.tv/*"],
      "js": ["content.js"],
      "css": ["page.css"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["http://127.0.0.1/pair.html*"],
      "js": ["pair.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.trycloudflare.com/motwi-join*", "http://127.0.0.1/motwi-join*"],
      "js": ["join-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*"],
      "matches": ["https://www.twitch.tv/*", "https://dashboard.twitch.tv/*"]
    }
  ]
}
